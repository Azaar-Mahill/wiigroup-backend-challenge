{
  "info": {
    "_postman_id": "wii-group-provider-registration-api",
    "name": "Provider Registration API",
    "description": "Wii Group — Provider Registration API Collection.\n\n**Setup:** Set the `base_url` collection variable to your running server (default: http://localhost:3000).\n\n**Flow:**\n1. Run **Admin Login** first — the token is saved automatically.\n2. Run **Register Provider**.\n3. Copy the returned `id` into the `provider_id` collection variable.\n4. Run **Get Provider** or **Verify Provider**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('admin_token', res.token);",
                  "  pm.test('Token saved to collection variable', function () {",
                  "    pm.expect(res.token).to.be.a('string');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": { "language": "json" }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Providers",
      "item": [
        {
          "name": "Register Provider",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('provider_id', res.id);",
                  "  pm.test('Provider ID saved', function () {",
                  "    pm.expect(res.id).to.be.a('string');",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "ABC Provider" },
                { "key": "email", "value": "abc@example.com" },
                { "key": "phone", "value": "+94771234567" },
                { "key": "business_type", "value": "Service Operator" },
                { "key": "documents", "value": "", "type": "file", "disabled": true }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/providers/register",
              "host": ["{{base_url}}"],
              "path": ["api", "providers", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Get Provider",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/providers/{{provider_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "providers", "{{provider_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Provider — Approve",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"notes\": \"Documents verified successfully\"\n}",
              "options": { "language": "json" }
            },
            "url": {
              "raw": "{{base_url}}/api/providers/{{provider_id}}/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "providers", "{{provider_id}}", "verify"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Provider — Reject",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"notes\": \"Missing required documents\"\n}",
              "options": { "language": "json" }
            },
            "url": {
              "raw": "{{base_url}}/api/providers/{{provider_id}}/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "providers", "{{provider_id}}", "verify"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "admin_token", "value": "" },
    { "key": "provider_id", "value": "" }
  ]
}
